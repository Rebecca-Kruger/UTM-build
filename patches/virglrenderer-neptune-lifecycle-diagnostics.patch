diff --git a/src/neptune/npt_common.c b/src/neptune/npt_common.c
index a232fee..6ec5e6f 100644
--- a/src/neptune/npt_common.c
+++ b/src/neptune/npt_common.c
@@ -6,6 +6,9 @@
 #include "npt_common.h"

 #include <stdarg.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>

 #include "util/u_debug.h"

@@ -17,6 +20,10 @@ static const struct debug_named_value npt_debug_options[] = {

 uint32_t npt_debug_flags;
 uint32_t npt_profile_period_ms;
+static mtx_t lifecycle_mutex;
+static bool lifecycle_mutex_ready;
+static FILE *lifecycle_file;
+static char lifecycle_path[1024];

 DEBUG_GET_ONCE_FLAGS_OPTION(npt_debug_flags, "NPT_DEBUG", npt_debug_options, 0)
 DEBUG_GET_ONCE_NUM_OPTION(npt_profile_period_ms_raw,
@@ -30,6 +37,64 @@ npt_debug_init(void)
    /* Clamp to a sane range so a huge value can't suppress dumps. */
    long v = debug_get_option_npt_profile_period_ms_raw();
    npt_profile_period_ms = (v > 0 && v < 60000) ? (uint32_t)v : 1000u;
+
+   const char *path = getenv("NPT_LIFECYCLE_LOG_PATH");
+   if (path && *path && strlen(path) < sizeof(lifecycle_path)) {
+      memcpy(lifecycle_path, path, strlen(path) + 1);
+      char previous[sizeof(lifecycle_path) + 16];
+      snprintf(previous, sizeof(previous), "%s.previous", lifecycle_path);
+      unlink(previous);
+      rename(lifecycle_path, previous);
+      lifecycle_mutex_ready =
+         mtx_init(&lifecycle_mutex, mtx_plain) == thrd_success;
+   }
+}
+
+static void
+npt_lifecycle_open(void)
+{
+   if (lifecycle_file || !lifecycle_path[0])
+      return;
+   lifecycle_file = fopen(lifecycle_path, "a");
+   if (lifecycle_file)
+      setvbuf(lifecycle_file, NULL, _IOLBF, 0);
+}
+
+void
+npt_lifecycle_log(const char *fmt, ...)
+{
+   if (!lifecycle_mutex_ready)
+      return;
+   mtx_lock(&lifecycle_mutex);
+   npt_lifecycle_open();
+   if (!lifecycle_file) {
+      mtx_unlock(&lifecycle_mutex);
+      return;
+   }
+
+   long pos = ftell(lifecycle_file);
+   if (pos >= 16 * 1024 * 1024) {
+      fclose(lifecycle_file);
+      lifecycle_file = NULL;
+      char previous[sizeof(lifecycle_path) + 16];
+      snprintf(previous, sizeof(previous), "%s.previous", lifecycle_path);
+      unlink(previous);
+      rename(lifecycle_path, previous);
+      npt_lifecycle_open();
+   }
+
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   fprintf(lifecycle_file, "%lld.%06ld pid=%d tid=%p ",
+           (long long)ts.tv_sec, ts.tv_nsec / 1000, getpid(),
+           (void *)(uintptr_t)thrd_current());
+   va_list va;
+   va_start(va, fmt);
+   vfprintf(lifecycle_file, fmt, va);
+   va_end(va);
+   fputc('\n', lifecycle_file);
+   fflush(lifecycle_file);
+   mtx_unlock(&lifecycle_mutex);
 }

 void
