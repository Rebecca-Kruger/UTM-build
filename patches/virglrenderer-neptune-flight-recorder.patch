+      " ev-register=%" PRIuFAST64 " ev-arm=%" PRIuFAST64
+      " ev-release=%" PRIuFAST64 " ev-pop=%" PRIuFAST64
+      " ev-miss=%" PRIuFAST64 " ev-live=%" PRIuFAST64
+      " ev-live-high=%" PRIuFAST64 " ev-pending=%" PRIuFAST64
+      " ev-pending-high=%" PRIuFAST64,
+      ctx->ctx_id, reason,
+      atomic_load_explicit(&ctx->flight.commands, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.command_bytes, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.transport_commands, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.top_commands, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.com_commands, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.last_sequence, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.last_cmd_type, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.last_object, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.command_hash, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_registers, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_arms, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_releases, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_pops, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_misses, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_live, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_live_high, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_pending, memory_order_relaxed),
+      atomic_load_explicit(&ctx->flight.event_pending_high, memory_order_relaxed));
+}
+
+static void
+npt_context_flight_record_command(struct npt_context *ctx,
+                                  const struct npt_command_header *command)
+{
+   const uint_fast64_t sequence =
+      atomic_fetch_add_explicit(&ctx->flight.commands, 1,
+                                memory_order_relaxed) + 1;
+   atomic_fetch_add_explicit(&ctx->flight.command_bytes, command->cmd_size,
+                             memory_order_relaxed);
+   atomic_store_explicit(&ctx->flight.last_sequence, sequence,
+                         memory_order_relaxed);
+   atomic_store_explicit(&ctx->flight.last_cmd_type, command->cmd_type,
+                         memory_order_relaxed);
+   atomic_store_explicit(&ctx->flight.last_object, command->object_id,
+                         memory_order_relaxed);
+
+   const uint32_t group = (command->cmd_type >> 24) & 0xffu;
+   if (group == 0)
+      atomic_fetch_add_explicit(&ctx->flight.transport_commands, 1,
+                                memory_order_relaxed);
+   else if (group == 255)
+      atomic_fetch_add_explicit(&ctx->flight.com_commands, 1,
+                                memory_order_relaxed);
+   else
+      atomic_fetch_add_explicit(&ctx->flight.top_commands, 1,
+                                memory_order_relaxed);
+
+   /* Use an order-independent signature: one atomic operation per command,
+    * with no retry loop that could serialize busy ring threads. */
+   uint_fast64_t signature = command->cmd_type;
+   signature *= UINT64_C(1099511628211);
+   signature ^= command->object_id;
+   signature *= UINT64_C(1099511628211);
+   signature ^= command->cmd_size;
+   atomic_fetch_xor_explicit(&ctx->flight.command_hash, signature,
+                             memory_order_relaxed);
+
+   /* One flushed snapshot per 256 decoded calls bounds diagnostic I/O even
+    * when Windows generates thousands of COM calls per second. */
+   if ((sequence & 255u) == 0)
+      npt_context_flight_snapshot(ctx, "periodic");
+}
