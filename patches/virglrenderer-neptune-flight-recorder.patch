@@ -740,6 +746,84 @@ npt_context_wait_ring_seqno(struct npt_context *ctx,
 /* cmd_type groups: 0 = transport (consumer-defined), 1-3 = top-level,
  * 255 = COM.  Transport commands must be intercepted here; the
  * protocol's default dispatcher sets fatal on them. */
+void
+npt_context_flight_snapshot(struct npt_context *ctx, const char *reason)
+{
+   npt_lifecycle_log(
+      "flight context ctx=%u reason=%s commands=%" PRIuFAST64
+      " bytes=%" PRIuFAST64 " transport=%" PRIuFAST64
+      " top=%" PRIuFAST64 " com=%" PRIuFAST64
+      " lastseq=%" PRIuFAST64 " lastcmd=0x%08" PRIxFAST64
