                  peek.cmd_type);
          npt_cs_decoder_set_fatal(dec);
@@ -768,7 +855,10 @@ npt_context_dispatch_one_command(struct npt_context *ctx,
       npt_dispatch_command(dispatch);
    }
 
-   return !npt_cs_decoder_get_fatal(dec);
+   const bool ok = !npt_cs_decoder_get_fatal(dec);
+   if (!ok)
+      npt_context_flight_snapshot(ctx, "dispatch-fatal");
+   return ok;
