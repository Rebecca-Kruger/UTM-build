+  return [=](pvalue ret) {
+    return make_irvalue_bind([=](context ctx) -> IRValue {
+      auto const_index = llvm::ConstantInt::get(ctx.llvm, llvm::APInt{32, from_reg, false});
+      auto fvec4 = co_yield load_from_array_at(ctx.resource.output.ptr_float4, const_index);
+      auto corrected =
+          ctx.builder.CreateFSub(fvec4, co_yield get_float4_splat(1.0f / 127500.0f));
+      auto alpha = ctx.builder.CreateExtractElement(corrected, uint64_t(3));
+      llvm::Value *routed = llvm::ConstantAggregateZero::get(corrected->getType());
+      routed = ctx.builder.CreateInsertElement(routed, alpha, uint64_t(0));
+      routed = ctx.builder.CreateInsertElement(routed, alpha, uint64_t(3));
+      co_return ctx.builder.CreateInsertValue(ret, routed, {to_element});
+    });
+  };
