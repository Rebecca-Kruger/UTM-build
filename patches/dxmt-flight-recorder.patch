+static void
+flight_summarize(EncoderData **encoders, unsigned encoder_count,
+                 FlightRecorderSummary &summary) {
+  summary.encoder_count = encoder_count;
+  summary.detail = str::format("summary encoders=", encoder_count, "\n");
+  for (unsigned i = 0; i < encoder_count; i++) {
+    EncoderData *current = encoders[i];
+    const auto type = static_cast<unsigned>(current->type);
+    if (type < 64)
+      summary.encoder_mask |= 1ull << type;
+    summary.detail += str::format(
+        "encoder index=", i, " encoder-type=", type,
+        " encoder-id=", static_cast<uint64_t>(current->id), "\n");
+
+    switch (current->type) {
+    case EncoderType::Render: {
+      auto data = static_cast<RenderEncoderData *>(current);
+      summary.render_count++;
+      summary.detail += str::format(
+          "encoder-state index=", i,
+          " rt=", data->render_target_width, "x", data->render_target_height,
+          " array=", data->render_target_array_length,
+          " samples=", data->default_raster_sample_count,
+          " flags=", data->use_visibility_result ? 1 : 0,
+          ":", data->use_tessellation ? 1 : 0,
+          ":", data->use_geometry ? 1 : 0,
+          ":", data->use_emulated_so ? 1 : 0,
+          ":", data->pipeline_invalid ? 1 : 0, "\n");
+      for (unsigned attachment_index = 0; attachment_index < std::size(data->colors); attachment_index++) {
+        auto color_texture = data->colors[attachment_index].attachment.texture();
+        auto resolve_texture = data->colors[attachment_index].resolve_attachment.texture();
+        if (color_texture || resolve_texture)
+          summary.detail += str::format(
+              "attachment index=", attachment_index,
+              " texture=", static_cast<uint64_t>(color_texture.handle),
+              " format=", color_texture ? static_cast<unsigned>(color_texture.pixelFormat()) : 0,
+              " resolve=", static_cast<uint64_t>(resolve_texture.handle),
+              " resolve-format=", resolve_texture ? static_cast<unsigned>(resolve_texture.pixelFormat()) : 0,
+              " load=", static_cast<unsigned>(data->colors[attachment_index].load_action),
+              " store=", static_cast<unsigned>(data->colors[attachment_index].store_action), "\n");
+      }
+      summary.render_target_width =
+          std::max(summary.render_target_width, data->render_target_width);
+      summary.render_target_height =
+          std::max(summary.render_target_height, data->render_target_height);
+      summary.render_flags |= data->use_visibility_result ? 1u : 0u;
+      summary.render_flags |= data->use_tessellation ? 2u : 0u;
+      summary.render_flags |= data->use_geometry ? 4u : 0u;
+      summary.render_flags |= data->use_emulated_so ? 8u : 0u;
+      summary.render_flags |= data->pipeline_invalid ? 16u : 0u;
+      flight_hash(summary.pipeline_hash,
+                  static_cast<uint64_t>(data->last_pso.handle));
+      if (data->last_pso)
+        summary.last_pipeline = static_cast<uint64_t>(data->last_pso.handle);
+      for (auto &color : data->colors) {
+        auto color_texture = color.attachment.texture();
+        auto resolve_texture = color.resolve_attachment.texture();
+        flight_hash(summary.resource_hash,
+                    static_cast<uint64_t>(color_texture.handle));
+        flight_hash(summary.resource_hash,
+                    static_cast<uint64_t>(resolve_texture.handle));
+        if (color_texture)
+          flight_hash(summary.attachment_format_hash,
+                      static_cast<uint64_t>(color_texture.pixelFormat()));
+        if (resolve_texture)
+          flight_hash(summary.attachment_format_hash,
+                      static_cast<uint64_t>(resolve_texture.pixelFormat()));
+      }
+      auto depth_texture = data->depth.attachment.texture();
+      auto stencil_texture = data->stencil.attachment.texture();
+      flight_hash(summary.resource_hash, static_cast<uint64_t>(depth_texture.handle));
+      flight_hash(summary.resource_hash, static_cast<uint64_t>(stencil_texture.handle));
+      if (depth_texture)
+        flight_hash(summary.attachment_format_hash,
+                    static_cast<uint64_t>(depth_texture.pixelFormat()));
+      if (stencil_texture)
+        flight_hash(summary.attachment_format_hash,
+                    static_cast<uint64_t>(stencil_texture.pixelFormat()));
+      flight_hash_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                           current->type, summary);
+      flight_detail_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                             current->type, i, current->id, summary.detail);
+      break;
+    }
+    case EncoderType::Compute: {
+      auto data = static_cast<ComputeEncoderData *>(current);
+      summary.compute_count++;
+      flight_hash_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                           current->type, summary);
+      flight_detail_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                             current->type, i, current->id, summary.detail);
+      break;
+    }
+    case EncoderType::Blit: {
+      auto data = static_cast<BlitEncoderData *>(current);
+      summary.blit_count++;
+      flight_hash_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                           current->type, summary);
+      flight_detail_commands(reinterpret_cast<wmtcmd_base *>(data->cmd_head.next.get()),
+                             current->type, i, current->id, summary.detail);
+      break;
+    }
+    case EncoderType::Present: {
+      auto data = static_cast<PresentData *>(current);
+      summary.present_count++;
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->backbuffer.handle));
+      break;
+    }
+    case EncoderType::Clear: {
+      auto data = static_cast<ClearEncoderData *>(current);
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->attachment.texture().handle));
+      break;
+    }
+    case EncoderType::Resolve: {
+      auto data = static_cast<ResolveEncoderData *>(current);
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->src.texture().handle));
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->dst.texture().handle));
+      break;
+    }
+    case EncoderType::SpatialUpscale: {
+      auto data = static_cast<SpatialUpscaleData *>(current);
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->backbuffer.handle));
+      flight_hash(summary.resource_hash,
+                  static_cast<uint64_t>(data->upscaled.handle));
+      break;
+    }
+    default:
+      break;
+    }
+  }
+}
