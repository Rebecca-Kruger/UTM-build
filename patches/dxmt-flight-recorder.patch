+void
+CommandQueue::DiagnosticLogSubmit(const std::string &message) {
+  if (!diagnostic_submit_stream_)
+    return;
+  const auto timestamp = std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  diagnostic_submit_stream_ << timestamp << " pid="
+#ifdef _WIN32
+                            << GetCurrentProcessId()
+#else
+                            << getpid()
+#endif
+                            << " tid=" << std::this_thread::get_id() << " "
+                            << message << std::endl;
+  diagnostic_submit_stream_.flush();
+}
