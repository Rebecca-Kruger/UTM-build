+static uint64_t
+flightPipelineColorHash(const WMTColorAttachmentBlendInfo *colors) {
+  uint64_t hash = 1469598103934665603ull;
+  for (unsigned i = 0; i < 8; i++) {
+    hash ^= static_cast<uint64_t>(colors[i].pixel_format);
+    hash *= 1099511628211ull;
+    hash ^= static_cast<uint64_t>(colors[i].write_mask) |
+            (static_cast<uint64_t>(colors[i].blending_enabled) << 8) |
+            (static_cast<uint64_t>(colors[i].rgb_blend_operation) << 16) |
+            (static_cast<uint64_t>(colors[i].alpha_blend_operation) << 24);
+    hash *= 1099511628211ull;
+  }
+  return hash;
+}
