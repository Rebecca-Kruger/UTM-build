+   * is observational only; the cap protects diagnostics from a corrupt cycle. */
+  for (uint32_t count = 0; command && count < 100000; count++) {
+    const uint16_t type = command->type;
+    summary.command_count++;
+    summary.last_command =
+        (static_cast<uint64_t>(encoder_type) << 32) | type;
+    flight_hash(summary.command_hash,
+                (static_cast<uint64_t>(encoder_type) << 32) | type);
+
+    if (encoder_type == EncoderType::Render) {
+      if ((type >= WMTRenderCommandDraw &&
+           type <= WMTRenderCommandDrawMeshThreadgroupsIndirect) ||
+          (type >= WMTRenderCommandDXMTGeometryDraw &&
+           type <= WMTRenderCommandDXMTGeometryDrawIndexedIndirect) ||
+          (type >= WMTRenderCommandDXMTTessellationMeshDraw &&
+           type <= WMTRenderCommandDXMTTessellationMeshDrawIndexedIndirect))
+        summary.draw_count++;
+      if (type == WMTRenderCommandSetPSO) {
+        auto pso = reinterpret_cast<wmtcmd_render_setpso *>(command)->pso;
+        summary.last_pipeline = static_cast<uint64_t>(pso);
+        summary.pipeline_bind_count++;
+        flight_hash(summary.pipeline_hash, static_cast<uint64_t>(pso));
+      } else if (type == WMTRenderCommandUseResource) {
+        auto resource = reinterpret_cast<wmtcmd_render_useresource *>(command)->resource;
+        summary.last_resource = static_cast<uint64_t>(resource);
+        summary.resource_bind_count++;
+        flight_hash(summary.resource_hash, static_cast<uint64_t>(resource));
+      } else if (type == WMTRenderCommandSetFragmentTexture) {
+        auto texture = reinterpret_cast<wmtcmd_render_settexture *>(command)->texture;
+        summary.last_resource = static_cast<uint64_t>(texture);
+        summary.resource_bind_count++;
+        flight_hash(summary.resource_hash, static_cast<uint64_t>(texture));
+      }
+    } else if (encoder_type == EncoderType::Compute) {
+      if (type == WMTComputeCommandDispatch ||
+          type == WMTComputeCommandDispatchIndirect ||
+          type == WMTComputeCommandDispatchThreads)
+        summary.dispatch_count++;
+      if (type == WMTComputeCommandSetPSO) {
+        auto pso = reinterpret_cast<wmtcmd_compute_setpso *>(command)->pso;
+        summary.last_pipeline = static_cast<uint64_t>(pso);
+        summary.pipeline_bind_count++;
+        flight_hash(summary.pipeline_hash, static_cast<uint64_t>(pso));
+      } else if (type == WMTComputeCommandUseResource) {
+        auto resource = reinterpret_cast<wmtcmd_compute_useresource *>(command)->resource;
+        summary.last_resource = static_cast<uint64_t>(resource);
+        summary.resource_bind_count++;
+        flight_hash(summary.resource_hash, static_cast<uint64_t>(resource));
+      } else if (type == WMTComputeCommandSetTexture) {
+        auto texture = reinterpret_cast<wmtcmd_compute_settexture *>(command)->texture;
+        summary.last_resource = static_cast<uint64_t>(texture);
+        summary.resource_bind_count++;
+        flight_hash(summary.resource_hash, static_cast<uint64_t>(texture));
+      }
+    } else if (encoder_type == EncoderType::Blit) {
+      if ((type >= WMTBlitCommandCopyFromBufferToBuffer &&
+           type <= WMTBlitCommandGenerateMipmaps) ||
+          type == WMTBlitCommandCopyFromBufferToTextureWithBlitOption)
+        summary.copy_count++;
+    }
+    command = reinterpret_cast<wmtcmd_base *>(command->next.get());
+  }
+}
