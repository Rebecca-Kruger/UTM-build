+        flight_hash(summary.resource_hash,
+                    static_cast<uint64_t>(color_texture.handle));
+        flight_hash(summary.resource_hash,
+                    static_cast<uint64_t>(resolve_texture.handle));
+        if (color_texture)
+          flight_hash(summary.attachment_format_hash,
+                      static_cast<uint64_t>(color_texture.pixelFormat()));
+        if (resolve_texture)
+          flight_hash(summary.attachment_format_hash,
+                      static_cast<uint64_t>(resolve_texture.pixelFormat()));
+      }
+      auto depth_texture = data->depth.attachment.texture();
+      auto stencil_texture = data->stencil.attachment.texture();
+      flight_hash(summary.resource_hash, static_cast<uint64_t>(depth_texture.handle));
+      flight_hash(summary.resource_hash, static_cast<uint64_t>(stencil_texture.handle));
+      if (depth_texture)
