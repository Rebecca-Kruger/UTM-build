+static void
+flight_detail_command(std::string &detail, wmtcmd_base *command,
+                      EncoderType encoder_type, unsigned encoder_index,
+                      EncoderId encoder_id, uint32_t ordinal) {
+  const auto type = command->type;
+  detail += str::format("encoder=", encoder_index,
+                        " encoder-type=", static_cast<unsigned>(encoder_type),
+                        " encoder-id=", static_cast<uint64_t>(encoder_id),
+                        " ordinal=", ordinal,
+                        " opcode=", type);
+  if (encoder_type == EncoderType::Render) {
+    switch (type) {
+    case WMTRenderCommandUseResource: {
+      auto cmd = reinterpret_cast<wmtcmd_render_useresource *>(command);
+      detail += str::format(" resource=", static_cast<uint64_t>(cmd->resource),
+                            " usage=", static_cast<unsigned>(cmd->usage),
+                            " stages=", static_cast<unsigned>(cmd->stages));
+      break;
+    }
+    case WMTRenderCommandSetVertexBuffer:
+    case WMTRenderCommandSetFragmentBuffer:
+    case WMTRenderCommandSetMeshBuffer:
+    case WMTRenderCommandSetObjectBuffer: {
+      auto cmd = reinterpret_cast<wmtcmd_render_setbuffer *>(command);
+      detail += str::format(" buffer=", static_cast<uint64_t>(cmd->buffer),
+                            " offset=", cmd->offset, " index=", static_cast<unsigned>(cmd->index));
+      break;
+    }
+    case WMTRenderCommandSetVertexBufferOffset:
+    case WMTRenderCommandSetFragmentBufferOffset:
+    case WMTRenderCommandSetMeshBufferOffset:
+    case WMTRenderCommandSetObjectBufferOffset: {
+      auto cmd = reinterpret_cast<wmtcmd_render_setbufferoffset *>(command);
+      detail += str::format(" offset=", cmd->offset, " index=", static_cast<unsigned>(cmd->index));
+      break;
+    }
+    case WMTRenderCommandSetFragmentTexture: {
+      auto cmd = reinterpret_cast<wmtcmd_render_settexture *>(command);
+      detail += str::format(" texture=", static_cast<uint64_t>(cmd->texture),
+                            " index=", static_cast<unsigned>(cmd->index));
+      break;
+    }
+    case WMTRenderCommandSetPSO: {
+      auto cmd = reinterpret_cast<wmtcmd_render_setpso *>(command);
+      detail += str::format(" pso=", static_cast<uint64_t>(cmd->pso));
+      break;
+    }
+    case WMTRenderCommandDraw: {
+      auto cmd = reinterpret_cast<wmtcmd_render_draw *>(command);
+      detail += str::format(" vertex-start=", cmd->vertex_start,
+                            " vertex-count=", cmd->vertex_count,
+                            " instances=", cmd->instance_count,
+                            " base-instance=", cmd->base_instance);
+      break;
+    }
+    case WMTRenderCommandDrawIndirect: {
+      auto cmd = reinterpret_cast<wmtcmd_render_draw_indirect *>(command);
+      detail += str::format(" indirect-buffer=", static_cast<uint64_t>(cmd->indirect_args_buffer),
+                            " indirect-offset=", cmd->indirect_args_offset);
+      break;
+    }
+    case WMTRenderCommandDrawIndexed: {
+      auto cmd = reinterpret_cast<wmtcmd_render_draw_indexed *>(command);
+      detail += str::format(" index-buffer=", static_cast<uint64_t>(cmd->index_buffer),
+                            " index-offset=", cmd->index_buffer_offset,
+                            " index-count=", cmd->index_count,
+                            " instances=", cmd->instance_count,
+                            " base-vertex=", cmd->base_vertex);
+      break;
+    }
+    case WMTRenderCommandDrawIndexedIndirect: {
+      auto cmd = reinterpret_cast<wmtcmd_render_draw_indexed_indirect *>(command);
+      detail += str::format(" index-buffer=", static_cast<uint64_t>(cmd->index_buffer),
+                            " index-offset=", cmd->index_buffer_offset,
+                            " indirect-buffer=", static_cast<uint64_t>(cmd->indirect_args_buffer),
+                            " indirect-offset=", cmd->indirect_args_offset);
+      break;
+    }
+    default:
+      break;
+    }
+  } else if (encoder_type == EncoderType::Compute) {
+    switch (type) {
+    case WMTComputeCommandSetBuffer: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_setbuffer *>(command);
+      detail += str::format(" buffer=", static_cast<uint64_t>(cmd->buffer),
+                            " offset=", cmd->offset, " index=", static_cast<unsigned>(cmd->index));
+      break;
+    }
+    case WMTComputeCommandSetPSO: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_setpso *>(command);
+      detail += str::format(" pso=", static_cast<uint64_t>(cmd->pso));
+      break;
+    }
+    case WMTComputeCommandUseResource: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_useresource *>(command);
+      detail += str::format(" resource=", static_cast<uint64_t>(cmd->resource),
+                            " usage=", static_cast<unsigned>(cmd->usage));
+      break;
+    }
+    case WMTComputeCommandSetTexture: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_settexture *>(command);
+      detail += str::format(" texture=", static_cast<uint64_t>(cmd->texture),
+                            " index=", static_cast<unsigned>(cmd->index));
+      break;
+    }
+    case WMTComputeCommandDispatch: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_dispatch *>(command);
+      detail += str::format(" threads=", cmd->size.width, "x", cmd->size.height,
+                            "x", cmd->size.depth);
+      break;
+    }
+    case WMTComputeCommandDispatchIndirect: {
+      auto cmd = reinterpret_cast<wmtcmd_compute_dispatch_indirect *>(command);
+      detail += str::format(" indirect-buffer=", static_cast<uint64_t>(cmd->indirect_args_buffer),
+                            " indirect-offset=", cmd->indirect_args_offset);
+      break;
+    }
+    default:
+      break;
+    }
+  } else if (encoder_type == EncoderType::Blit) {
+    switch (type) {
+    case WMTBlitCommandCopyFromBufferToBuffer: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_copy_from_buffer_to_buffer *>(command);
+      detail += str::format(" src=", static_cast<uint64_t>(cmd->src),
+                            " src-offset=", cmd->src_offset,
+                            " dst=", static_cast<uint64_t>(cmd->dst),
+                            " dst-offset=", cmd->dst_offset,
+                            " length=", cmd->copy_length);
+      break;
+    }
+    case WMTBlitCommandCopyFromBufferToTexture:
+    case WMTBlitCommandCopyFromBufferToTextureWithBlitOption: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_copy_from_buffer_to_texture *>(command);
+      detail += str::format(" src=", static_cast<uint64_t>(cmd->src),
+                            " src-offset=", cmd->src_offset,
+                            " bytes-per-row=", cmd->bytes_per_row,
+                            " bytes-per-image=", cmd->bytes_per_image,
+                            " size=", cmd->size.width, "x", cmd->size.height,
+                            "x", cmd->size.depth,
+                            " dst=", static_cast<uint64_t>(cmd->dst),
+                            " dst-slice=", cmd->slice,
+                            " dst-level=", cmd->level,
+                            " dst-origin=", cmd->origin.x, ",", cmd->origin.y,
+                            ",", cmd->origin.z);
+      if (type == WMTBlitCommandCopyFromBufferToTextureWithBlitOption) {
+        auto option_cmd = reinterpret_cast<wmtcmd_blit_copy_from_buffer_to_texture_withblitoption *>(command);
+        detail += str::format(" options=", option_cmd->options);
+      }
+      break;
+    }
+    case WMTBlitCommandCopyFromTextureToBuffer: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_copy_from_texture_to_buffer *>(command);
+      detail += str::format(" src=", static_cast<uint64_t>(cmd->src),
+                            " src-slice=", cmd->slice,
+                            " src-level=", cmd->level,
+                            " src-origin=", cmd->origin.x, ",", cmd->origin.y,
+                            ",", cmd->origin.z,
+                            " size=", cmd->size.width, "x", cmd->size.height,
+                            "x", cmd->size.depth,
+                            " dst=", static_cast<uint64_t>(cmd->dst),
+                            " dst-offset=", cmd->offset,
+                            " bytes-per-row=", cmd->bytes_per_row,
+                            " bytes-per-image=", cmd->bytes_per_image);
+      break;
+    }
+    case WMTBlitCommandCopyFromTextureToTexture: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_copy_from_texture_to_texture *>(command);
+      detail += str::format(" src=", static_cast<uint64_t>(cmd->src),
+                            " src-slice=", cmd->src_slice,
+                            " src-level=", cmd->src_level,
+                            " src-origin=", cmd->src_origin.x, ",", cmd->src_origin.y,
+                            ",", cmd->src_origin.z,
+                            " src-size=", cmd->src_size.width, "x", cmd->src_size.height,
+                            "x", cmd->src_size.depth,
+                            " dst=", static_cast<uint64_t>(cmd->dst),
+                            " dst-slice=", cmd->dst_slice,
+                            " dst-level=", cmd->dst_level,
+                            " dst-origin=", cmd->dst_origin.x, ",", cmd->dst_origin.y,
+                            ",", cmd->dst_origin.z);
+      break;
+    }
+    case WMTBlitCommandGenerateMipmaps: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_generate_mipmaps *>(command);
+      detail += str::format(" texture=", static_cast<uint64_t>(cmd->texture));
+      break;
+    }
+    case WMTBlitCommandWaitForFence:
+    case WMTBlitCommandUpdateFence: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_fence_op *>(command);
+      detail += str::format(" fence=", static_cast<uint64_t>(cmd->fence));
+      break;
+    }
+    case WMTBlitCommandResolveCounters: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_resolvecounters *>(command);
+      detail += str::format(" sample-buffer=", static_cast<uint64_t>(cmd->sample_buffer),
+                            " start=", cmd->start, " length=", cmd->len,
+                            " dst-buffer=", static_cast<uint64_t>(cmd->dst_buffer),
+                            " dst-offset=", cmd->dst_offset);
+      break;
+    }
+    case WMTBlitCommandFillBuffer: {
+      auto cmd = reinterpret_cast<wmtcmd_blit_fillbuffer *>(command);
+      detail += str::format(" buffer=", static_cast<uint64_t>(cmd->buffer),
+                            " offset=", cmd->offset, " length=", cmd->length,
+                            " value=", static_cast<unsigned>(cmd->value));
+      break;
+    }
+    default:
+      break;
+    }
+  }
+  detail += "\n";
+}
+
+static void
+flight_detail_commands(wmtcmd_base *command, EncoderType encoder_type,
+                       unsigned encoder_index, EncoderId encoder_id,
+                       std::string &detail) {
+  for (uint32_t ordinal = 0; command && ordinal < 100000; ordinal++) {
+    flight_detail_command(detail, command, encoder_type, encoder_index, encoder_id, ordinal);
+    command = reinterpret_cast<wmtcmd_base *>(command->next.get());
+  }
+}
+
+static void
+flight_tag_encoder(WMT::CommandEncoder &encoder, uint64_t queue_id,
+                   uint64_t submission_id, unsigned encoder_index,
+                   EncoderData *data) {
+  auto label = WMT::String::string(
+      str::format("DXMT q=", queue_id, " s=", submission_id,
+                  " e=", encoder_index, " id=", static_cast<uint64_t>(data->id),
+                  " t=", static_cast<unsigned>(data->type)).c_str(),
+      WMTUTF8StringEncoding);
+  encoder.setLabel(label);
+}
+
+template <typename Encoder, typename Nop>
+static void
+flight_encode_commands(Encoder &encoder, wmtcmd_base *command, uint64_t queue_id,
+                       uint64_t submission_id, unsigned encoder_index,
+                       EncoderData *data) {
+  uint32_t ordinal = 0;
+  for (; command && ordinal < 100000; ordinal++) {
+    auto next = command->next.get();
+    command->next.set(nullptr);
+    auto signpost = WMT::String::string(
+        str::format("DXMT q=", queue_id, " s=", submission_id,
+                    " e=", encoder_index, " id=", static_cast<uint64_t>(data->id),
+                    " c=", ordinal, " op=", command->type).c_str(),
+        WMTUTF8StringEncoding);
+    encoder.insertDebugSignpost(signpost);
+    encoder.encodeCommands(reinterpret_cast<const Nop *>(command));
+    command->next.set(next);
+    command = reinterpret_cast<wmtcmd_base *>(next);
+  }
+}
